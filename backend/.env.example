# API server
PORT=4000

# MySQL 8+; create the database before first startup
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=nazmarket
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_CONNECTION_LIMIT=10

# Generate a persistent 32-byte hex key before accepting seller identity/bank data:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SELLER_PII_KEY=

# Super admin (no built-in/default password). Hash using backend/hash-admin-password.js.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# MeliPayamak OTP endpoint URL, stored only on the backend (never use VITE_ vars).
# Rotate the provider key if it has appeared in a screenshot or chat.
MELIPAYAMAK_OTP_URL=
# Persistent server-side pepper for hashed one-time codes (at least 32 random characters).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_OTP_HASH_KEY=
