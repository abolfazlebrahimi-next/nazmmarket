# API server
PORT=4000

# MySQL 8+; create the database before first startup
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=nazmarket
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_CONNECTION_LIMIT=10

# Generate a persistent 32-byte hex key before accepting seller identity/bank data:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SELLER_PII_KEY=93d6fd0ff3e97916f5828b42d90d2eaeab40d1a80f4b6d57274f31c7be15611e

# Super admin (no built-in/default password). Hash using backend/hash-admin-password.js.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
