# API URL for frontend development (Vite proxies /api to port 4000)
# VITE_API_URL=/api

# API server port
PORT=4000

# MySQL 8+ connection settings; create the database once before first startup.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=nazmarket
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_CONNECTION_LIMIT=10

# Demo account created automatically on first startup
DEMO_PHONE=09123456789
DEMO_PASSWORD=123456
